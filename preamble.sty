% CV tag for skills
\newcommand{\cvtag}[1]{%
    \tikz[baseline]\node[anchor=base,draw=black!30,rounded corners,inner xsep=1ex,inner ysep =0.75ex,text height=1.5ex,text depth=.25ex]{\footnotesize #1};
}

% List Skills
\newcommand{\listskills}[1]{%
    \begin{center}%
        \foreach \tag in #1 {%
                \cvtag{\tag}%
            }%
    \end{center}%
}
