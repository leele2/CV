%% Other Interests %%
% Define the other interests command that takes a list
\newcommand{\otherInterests}[1]{%
    \small
    \begin{multicols}{2}
        \begin{itemize}
            \foreach \x in #1 {
            \foreach \icon/\interest in \x {
            \item[\icon] \interest
                }
                }
        \end{itemize}
    \end{multicols}
}
%% %%

%% Technical Expertise and Applications %%
\newcommand{\techExpertiseApplication}[2]{ % input: Skill, Application
    \adjustbox{valign=t}{
        \begin{minipage}{2cm}
            \begin{center}
                {\footnotesize \bfseries #1} \\
                \vspace*{0.1cm}
            \end{center}
        \end{minipage}}
    \hfill \vline \hfill
    \adjustbox{valign=t}{
        \begin{minipage}{8.5cm}
            \foreach \technology/\example in #2 {
                    \footnotesize \textbf{\technology}:
                    \example \par\vspace{0.1cm}
                }
        \end{minipage}}
}

% Define the new command that processes the list of competencies
\newcommand{\techExpertiseApplications}[1]{%
    \foreach \x in {#1} {
            \foreach \a/\b in \x {
                \techExpertiseApplication{\a}{\b}
                %
            }
            
            \sectionspace
        }
}
