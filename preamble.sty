%% Project Section %%
% project display format function
\newcommand{\project}[7]{ % project-type, year, title, details, url, url-embeded text, languages used
    \footnotesize
    \textbf{#3}\newline
    #4
    {\hspace{0.1mm} \href{#5}{\faGithub#6}~-~\normalsize
        \foreach \x in {#7}{
                {\x}~
            }}
}

% Define the projects command that takes an input
\newcommand{\projects}[1]{%
    \foreach \x [count=\i] in #1 {
            % Add \sectionspace above for all except the first project
            \ifnum\i > 1
                \sectionspace
            \fi
            \foreach \projectType/\year/\title/\details/\url/\urlText/\technologies in \x {
                \project{\projectType}{\year}{\title}{\details}{\url}{\urlText}{\technologies}
            }
            \par
        }
}
