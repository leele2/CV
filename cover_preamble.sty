\newcommand*{\recipient}[4]{
    \begin{minipage}[t]{0.4\textwidth}
        \textbf{#1} \\
        {#3}
    \end{minipage}
    \hfill
    \begin{minipage}[t]{0.4\textwidth}
        \begin{flushright}
            \today{}
        \end{flushright}
    \end{minipage}
    \vspace*{0.4cm}
    \ruleline{\textbf{#4}}\\
    \vspace*{0.4cm}
    Dear {#2},\\
}

% Command for letter content
\usepackage{ragged2e}
\usepackage[skip=0.2cm]{parskip}
\newcommand\coverContent[1]{
    \begin{justify}
        \foreach \x in {#1}{
                \noindent{}{\x}\par
            }
    \end{justify}
}

% Define constants for the 5 variables for coverhead function
\newcommand{\myHeaderColor}{titleBackColor} % Background color for the header
\newcommand{\myFirstName}{Lee}            % First name
\newcommand{\myLastName}{Luderman}        % Last name
\newcommand{\myDescription}{Computational Data Analyst | Software Engineers | Expertise in Python, R, and \textsc{Matlab}}  % Description
\newcommand{\myTextColor}{white}          % Text color for the header
% The coverheader function
\newcommand{\coverheader}[5]{
    \tikz[remember picture,overlay] {%
        \node[rectangle, fill=#1, anchor=north, minimum width=\paperwidth, minimum height=3.5cm](header) at (current page.north){};% 
        \node[draw=none, align=left](name) at (header) {%
            {\Huge \color{#5} #2 \textbf{#3}}%
        };%
        \node[draw=none, below](description) at (name.south) {\color{white}#4};% 
    }\vspace{-0.7cm}%
    \vspace*{3.5cm}
    \flushleft{\adjustbox{valign=t, width = \paperwidth}{%
            \hspace{-\dimexpr1in+\oddsidemargin\relax}%
            \begin{tcolorbox}[colback=sideBarColor,boxrule=0pt,frame empty,sharp corners, halign=center, width = \paperwidth]
                \hspace{-\dimexpr1in+\oddsidemargin\relax}%
                \begin{tabular}{c | c | c}
                    \faEnvelope{} \href{mailto:leeluderman@googlemail.com}{leeluderman@googlemail.com} &
                    \faPhone{} +61 420254547                                                           &
                    \faMapMarker{} Sydney, NSW 2218, Australia
                \end{tabular}
            \end{tcolorbox}
        }}
    \vspace*{0.2cm}
}


